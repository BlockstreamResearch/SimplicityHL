pub mod temp {
    pub mod funcs {
        pub type Smth = u32;
        pub fn get_five() -> u32 {
        5}
    }
    pub mod constants {
        pub mod utils {
            pub use crate::temp::funcs::Smth;
            pub fn two() -> Smth {
            2}
        }
    }
}
pub use crate::temp::constants::utils::two as smth;
use crate::temp::funcs::{get_five, Smth};
fn seven() -> u32 {
7}

fn main() {
let (_, temp): (bool, u32) = jet::add_32(smth(), get_five());
    assert!(jet::eq_32(temp, seven()));
